<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Accent: replaced at runtime by ThemeService when the user picks a colour in Settings. -->
    <Color x:Key="AccentColor">#8B5CF6</Color>
    <Color x:Key="AccentGlowColor">#8B5CF6</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#8B5CF6" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#338B5CF6" />

    <SolidColorBrush x:Key="WindowBrush" Color="#0D0E13" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#111219" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#15171F" />
    <SolidColorBrush x:Key="CardBrush" Color="#1A1D27" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#202432" />
    <SolidColorBrush x:Key="BorderBrush" Color="#262A38" />
    <SolidColorBrush x:Key="InputBrush" Color="#12141B" />
    <SolidColorBrush x:Key="TextBrush" Color="#ECEEF4" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8B91A4" />
    <SolidColorBrush x:Key="FaintBrush" Color="#5B6175" />

    <SolidColorBrush x:Key="SafeBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="SafeSoftBrush" Color="#2622C55E" />
    <SolidColorBrush x:Key="ModerateBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="ModerateSoftBrush" Color="#26F59E0B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#26EF4444" />
    <SolidColorBrush x:Key="InfoBrush" Color="#3B82F6" />

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
</ResourceDictionary>

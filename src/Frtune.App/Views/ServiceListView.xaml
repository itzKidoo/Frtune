<UserControl x:Class="Frtune.App.Views.ServiceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Frtune.App.ViewModels">
    <StackPanel>
        <DockPanel>
            <CheckBox DockPanel.Dock="Right" Content="Show all services" IsChecked="{Binding Expanded}" VerticalAlignment="Top" />
            <StackPanel>
                <TextBlock Text="All services" Style="{StaticResource H2}" />
                <TextBlock Text="Change any service's startup type. The original is saved the first time, so Undo puts it back. Essential and security services can't be disabled." Style="{StaticResource Muted}" Margin="0,2,0,12" />
            </StackPanel>
        </DockPanel>
        <StackPanel Visibility="{Binding Expanded, Converter={StaticResource BoolToVis}}">
            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=200}" Width="320" HorizontalAlignment="Left" Margin="0,0,0,10" ToolTip="Filter by name" />
            <TextBlock Text="Loading services…" Style="{StaticResource Muted}" Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}" />
            <Border Style="{StaticResource Card}" Padding="6">
                <ListBox ItemsSource="{Binding View}" Height="460" Background="Transparent" BorderThickness="0"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Padding="10,6" CornerRadius="6" Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#0AFFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Description}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="250" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Name}" FontSize="10.5" Foreground="{DynamicResource FaintBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="Rec" Grid.Column="1" Text="{Binding Recommendation}" FontSize="11.5" Foreground="{DynamicResource SafeBrush}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                <ItemsControl Grid.Column="3" ItemsSource="{x:Static vm:ServiceListViewModel.StartTypes}" Tag="{Binding}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button x:Name="Seg" Style="{StaticResource ChipButton}" Margin="0,0,3,0" FontSize="10.5" Padding="8,3"
                                                    Content="{Binding Converter={StaticResource StartTypeLabel}}" ToolTip="{Binding}"
                                                    Command="{Binding Tag.ChangeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            <DataTemplate.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource AreEqual}">
                                                            <Binding />
                                                            <Binding Path="Tag.StartType" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter TargetName="Seg" Property="Tag" Value="True" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Grid.Column="4" Content="Undo" Style="{StaticResource GhostButton}" Padding="8,4"
                                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsKeep}" Value="True">
                                    <Setter TargetName="Rec" Property="Foreground" Value="{DynamicResource ModerateBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>

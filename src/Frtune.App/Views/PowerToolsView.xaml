<UserControl x:Class="Frtune.App.Views.PowerToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Frtune.App.ViewModels">
    <StackPanel>
        <TextBlock Text="Power plans" Style="{StaticResource H2}" />
        <TextBlock Text="The tweaks above change the active plan. Create your own plan first if you want to keep Windows' plans untouched." Style="{StaticResource Muted}" Margin="0,2,0,12" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Plans}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3">
                                <Button x:Name="Act" DockPanel.Dock="Right" Content="Activate" Padding="12,4"
                                        Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                <Border x:Name="On" DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,8,0" Visibility="Collapsed">
                                    <TextBlock Text="Active" Foreground="{DynamicResource TextBrush}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Guid}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{DynamicResource FaintBrush}" />
                                </StackPanel>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Active}" Value="True">
                                    <Setter TargetName="On" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Act" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Separator Margin="0,12" Background="{DynamicResource BorderBrush}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="New plan" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Width="200" />
                    <TextBlock Text="based on" VerticalAlignment="Center" Margin="10,0,8,0" />
                    <ComboBox ItemsSource="{x:Static vm:PowerToolsViewModel.Bases}" SelectedItem="{Binding Base}" Width="190" />
                    <Button Content="Create &amp; activate" Command="{Binding CreateCommand}" Margin="10,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

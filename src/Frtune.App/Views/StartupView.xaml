<UserControl x:Class="Frtune.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Top" />
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,4,0,2" FontSize="13" />
                <TextBlock Text="{Binding Summary}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
            <ListBox ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Padding="12,8" CornerRadius="8" Background="Transparent"><ContentPresenter /></Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#0AFFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTip="{Binding Command}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Publisher}" Style="{StaticResource Muted}" FontSize="11.5" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Source}" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" VerticalAlignment="Center" />
                            <Border Grid.Column="2" x:Name="Imp" Style="{StaticResource RiskBadge}" Tag="Safe" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Impact}" />
                            </Border>
                            <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Impact}" Value="Medium"><Setter TargetName="Imp" Property="Tag" Value="Moderate" /></DataTrigger>
                            <DataTrigger Binding="{Binding Impact}" Value="High"><Setter TargetName="Imp" Property="Tag" Value="Advanced" /></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>

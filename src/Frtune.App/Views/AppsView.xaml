<UserControl x:Class="Frtune.App.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <Button Content="Remove selected" Style="{StaticResource DangerButton}" Command="{Binding RemoveSelectedCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Preinstalled apps" Style="{StaticResource H2}" />
                <TextBlock Text="Suggested removals are pre-ticked. Store, Calculator, Photos, Terminal, codecs and drivers are protected and can't be removed." Style="{StaticResource Muted}" Margin="0,2,0,4" />
                <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" Margin="0,0,0,12" />
            </StackPanel>
        </DockPanel>
        <Border Style="{StaticResource Card}" Padding="8">
            <ItemsControl ItemsSource="{Binding Apps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,7" Margin="2" CornerRadius="8" Background="Transparent" ToolTip="{Binding PackageName}">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Visibility="{Binding IsProtected, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Protected" />
                                </Border>
                                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding PackageName}" FontSize="10.5" Foreground="{DynamicResource FaintBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </CheckBox>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,14,0,0" BorderBrush="{DynamicResource ModerateBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Uninstall OneDrive…" Style="{StaticResource DangerButton}" Command="{Binding UninstallOneDriveCommand}" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="Remove OneDrive" FontWeight="SemiBold" />
                    <TextBlock Text="Uses Microsoft's own uninstaller. Downloaded files stay in your OneDrive folder; online-only files stay in the cloud. To just stop syncing, use the reversible &quot;Disable OneDrive sync&quot; toggle above instead." Style="{StaticResource Muted}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>

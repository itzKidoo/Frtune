<Window x:Class="Frtune.App.Views.ConfirmPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm changes" Width="760" Height="640" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}" FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextBrush}"
        ResizeMode="CanResize" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid Margin="22,16,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="Heading" Style="{StaticResource H2}" FontSize="19" />
            <TextBlock x:Name="SubHeading" Style="{StaticResource Muted}" Margin="0,4,0,14" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Items">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="B" Margin="0,0,6,10" Padding="14,12" CornerRadius="10" Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource RiskBadge}" Tag="{Binding Risk}">
                                        <TextBlock Text="{Binding Risk}" />
                                    </Border>
                                    <TextBlock x:Name="Verb" Text="{Binding Verb}" FontWeight="SemiBold" Foreground="{DynamicResource SafeBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                </DockPanel>
                                <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12.5"
                                           Visibility="{Binding Warning, Converter={StaticResource EmptyToCollapsed}}" />
                                <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource ModerateBrush}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12.5"
                                           Visibility="{Binding Problem, Converter={StaticResource EmptyToCollapsed}}" />
                                <TextBlock Text="{Binding Lines}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding Lines, Converter={StaticResource EmptyToCollapsed}}" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Enable}" Value="False">
                                <Setter TargetName="Verb" Property="Foreground" Value="{DynamicResource InfoBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Skipped}" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.6" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <CheckBox x:Name="Understand" Margin="0,0,0,12" Visibility="Collapsed" Checked="Understand_Changed" Unchecked="Understand_Changed">
                <TextBlock Text="I understand the warnings above and want to apply these Advanced changes." TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
            </CheckBox>
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="OkButton" Style="{StaticResource PrimaryButton}" Content="Apply changes" Padding="22,9" Click="Ok_Click" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Cancel" Click="Cancel_Click" IsCancel="True" />
                <TextBlock x:Name="Footer" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>

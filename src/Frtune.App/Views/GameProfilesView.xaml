<UserControl x:Class="Frtune.App.Views.GameProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Frtune.App.ViewModels">
    <StackPanel>
        <TextBlock Text="Per-game settings" Style="{StaticResource H2}" />
        <TextBlock Text="GPU preference and CPU priority are stored where Windows reads them, so they apply every time the game starts, even when frtune isn't running." Style="{StaticResource Muted}" Margin="0,2,0,4" />
        <TextBlock Text="{Binding GpuNote}" Foreground="{DynamicResource AccentBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="GPU" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{x:Static vm:GameProfilesViewModel.GpuChoices}" SelectedItem="{Binding Gpu}" Width="170" />
                    <TextBlock Text="CPU priority" VerticalAlignment="Center" Margin="16,0,8,0" />
                    <ComboBox ItemsSource="{x:Static vm:GameProfilesViewModel.PriorityChoices}" SelectedItem="{Binding Priority}" Width="150" />
                    <Button Content="Add game .exe…" Command="{Binding AddGameCommand}" Margin="16,0,0,0" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Games}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,4">
                                <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource GhostButton}"
                                        Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                <TextBlock DockPanel.Dock="Right" Width="230" VerticalAlignment="Center" Style="{StaticResource Muted}">
                                    <Run Text="GPU: " /><Run Text="{Binding Gpu, Mode=OneWay}" /><Run Text=" · CPU: " /><Run Text="{Binding Priority, Mode=OneWay}" />
                                </TextBlock>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Exe}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

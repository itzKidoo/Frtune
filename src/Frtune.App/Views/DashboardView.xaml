<UserControl x:Class="Frtune.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Frtune.App.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="UsageCardTemplate">
            <Border Style="{StaticResource Card}" Margin="0,0,14,14" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="64" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" FontSize="22" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding Detail}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,8" />
                    <c:Sparkline Grid.Row="2" Values="{Binding History}" Stroke="{DynamicResource AccentBrush}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18,10,18">
        <StackPanel>
            <DockPanel Margin="0,0,14,18">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding Main.OptimizeCommand}" Padding="28,14" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" Foreground="White" FontSize="18" Margin="0,0,10,0" />
                        <StackPanel>
                            <TextBlock Text="Optimize" Foreground="White" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="Balanced + tuned for this PC" Foreground="#DDFFFFFF" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Dashboard" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding Main.SystemSummary}" Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="13" />
                </StackPanel>
            </DockPanel>

            <!-- Live usage -->
            <UniformGrid Columns="4">
                <ContentControl Content="{Binding Cpu}" ContentTemplate="{StaticResource UsageCardTemplate}" />
                <ContentControl Content="{Binding Gpu}" ContentTemplate="{StaticResource UsageCardTemplate}" />
                <ContentControl Content="{Binding Ram}" ContentTemplate="{StaticResource UsageCardTemplate}" />
                <ContentControl Content="{Binding Disk}" ContentTemplate="{StaticResource UsageCardTemplate}" />
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="7*" />
                </Grid.ColumnDefinitions>

                <!-- Health score -->
                <Border Style="{StaticResource Card}" Margin="0,0,14,14" Padding="20">
                    <StackPanel>
                        <TextBlock Text="System health" Style="{StaticResource H2}" />
                        <TextBlock Text="Every point is explained below, so you can see what to fix." Style="{StaticResource Muted}" Margin="0,2,0,14" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="130" Height="130" VerticalAlignment="Top">
                                <c:RingGauge Value="{Binding HealthScore}" Stroke="{DynamicResource AccentBrush}" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding HealthScore}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding HealthGrade}" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding HealthFactors}" Margin="12,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11.5" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center">
                                                <Run Text="{Binding Score, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" /><Run Text="/" /><Run Text="{Binding Max, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Open Cleaner" Command="{Binding OpenCleanerCommand}" Margin="0,0,8,0" />
                            <Button Content="Review startup apps" Command="{Binding OpenStartupCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- OS + recommendations -->
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                        <DockPanel>
                            <TextBlock Text="&#xE7F8;" Style="{StaticResource Icon}" FontSize="26" Foreground="{DynamicResource AccentBrush}" Margin="0,0,14,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding Os}" Style="{StaticResource H2}" />
                                <TextBlock Text="{Binding OsDetail}" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                        <StackPanel>
                            <TextBlock Text="Recommended for this PC" Style="{StaticResource H2}" />
                            <TextBlock Text="Picked from your hardware. The Optimize button includes all of these." Style="{StaticResource Muted}" Margin="0,2,0,12" />
                            <ItemsControl ItemsSource="{Binding Recommended}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,10">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsOn}" IsEnabled="{Binding CanToggle}" VerticalAlignment="Center" />
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{Binding Recommendation}" Style="{StaticResource Muted}" FontSize="11.5" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Frtune.App.ViewModels"
                    xmlns:v="clr-namespace:Frtune.App.Views">

    <!-- ===================== Tweak card ===================== -->
    <DataTemplate DataType="{x:Type vm:TweakItemViewModel}">
        <Grid x:Name="Root" Width="384" Margin="0,0,14,14">
            <Border x:Name="Glow" CornerRadius="12" Background="{DynamicResource CardBrush}" Opacity="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.7" Color="{DynamicResource AccentGlowColor}" />
                </Border.Effect>
            </Border>
            <Border x:Name="Card" Style="{StaticResource HoverCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsOn}"
                                  IsEnabled="{Binding CanToggle}" VerticalAlignment="Top" Margin="12,0,0,0" />
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,6,0,10" />
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{Binding Recommendation}" Foreground="{DynamicResource AccentBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding Recommendation, Converter={StaticResource EmptyToCollapsed}}" />
                        <WrapPanel>
                            <Border Style="{StaticResource RiskBadge}" Tag="{Binding Risk}" Margin="0,0,6,4">
                                <TextBlock Text="{Binding Risk}" />
                            </Border>
                            <Border Style="{StaticResource Pill}" Margin="0,0,6,4" Visibility="{Binding NeedsRestart, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,1,4,0" Foreground="{DynamicResource MutedBrush}" />
                                    <TextBlock Text="{Binding RestartText}" Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Pill}" Margin="0,0,6,4" Background="{DynamicResource AccentSoftBrush}"
                                    Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="For your PC" Foreground="{DynamicResource TextBrush}" />
                            </Border>
                            <Border Style="{StaticResource Pill}" Margin="0,0,6,4" Background="{DynamicResource AccentBrush}"
                                    Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Pending" Foreground="White" FontWeight="SemiBold" />
                            </Border>
                            <Border Style="{StaticResource Pill}" Margin="0,0,6,4" Visibility="{Binding NotApplicableReason, Converter={StaticResource EmptyToCollapsed}}">
                                <TextBlock Text="{Binding NotApplicableReason}" />
                            </Border>
                        </WrapPanel>
                        <DockPanel Margin="0,4,0,0">
                            <Border DockPanel.Dock="Right" Background="Transparent" Cursor="Help" ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000">
                                <Border.ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="What this changes" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding Details}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border.ToolTip>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Details" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,0,5,0" />
                                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsApplicable}" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
            </DataTrigger>
            <EventTrigger RoutedEvent="MouseEnter" SourceName="Root">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.15" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave" SourceName="Root">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ===================== Page → view mapping ===================== -->
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:QuickOptimizeViewModel}"><v:QuickOptimizeView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:TweakPageViewModel}"><v:TweakPageView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SearchViewModel}"><v:SearchView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:StartupViewModel}"><v:StartupView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CleanerViewModel}"><v:CleanerView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:BackupsViewModel}"><v:BackupsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:HardwareViewModel}"><v:HardwareView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:BenchmarkViewModel}"><v:BenchmarkView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProcessesViewModel}"><v:ProcessesView /></DataTemplate>
    <!-- Extra tool sections shown under a tweak page -->
    <DataTemplate DataType="{x:Type vm:NetworkToolsViewModel}"><v:NetworkToolsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:GameProfilesViewModel}"><v:GameProfilesView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AppsViewModel}"><v:AppsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ServiceListViewModel}"><v:ServiceListView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PowerToolsViewModel}"><v:PowerToolsView /></DataTemplate>
</ResourceDictionary>
